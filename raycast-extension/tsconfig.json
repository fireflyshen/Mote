{
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src/**/*",
    "raycast-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
