{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mote",
  "title": "Mote",
  "description": "Capture your thoughts and sync them to your Mote server.",
  "icon": "extension-icon.png",
  "author": "fireflyshen",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "send-to-mote",
      "title": "Send to Mote",
      "subtitle": "Mote",
      "description": "Write a memo and tags, then send with Command + Enter.",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "transport",
      "type": "dropdown",
      "required": true,
      "title": "Connection",
      "default": "ssh",
      "description": "SSH uses your existing RN connection. HTTPS is available when your domain is ready.",
      "data": [
        {
          "title": "SSH (RN)",
          "value": "ssh"
        },
        {
          "title": "HTTPS",
          "value": "https"
        }
      ]
    },
    {
      "name": "sshTarget",
      "type": "textfield",
      "required": false,
      "title": "SSH Host",
      "description": "An existing host in ~/.ssh/config.",
      "default": "rn"
    },
    {
      "name": "serverUrl",
      "type": "textfield",
      "required": true,
      "title": "Server URL",
      "description": "Your Mote website address.",
      "default": "https://mote.caten.top",
      "placeholder": "https://mote.caten.top"
    },
    {
      "name": "captureToken",
      "type": "password",
      "required": true,
      "title": "Capture Token",
      "description": "Generate a capture token in Mote \u2192 Settings & Raycast."
    },
    {
      "name": "defaultTags",
      "type": "textfield",
      "required": false,
      "title": "Default Tags",
      "description": "Space-separated tags, for example #\u60f3\u6cd5 #\u788e\u8bb0.",
      "default": ""
    }
  ],
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "lint": "eslint src && prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint:store": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "latest",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "typescript": "~6.0.2",
    "@raycast/eslint-config": "latest",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2"
  }
}
