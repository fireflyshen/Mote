{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mote",
  "title": "Mote",
  "description": "A floating notepad with automatic saving and Mote synchronization.",
  "icon": "extension-icon.png",
  "author": "fireflyshen",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "commands": [
    {
      "name": "mote-notes",
      "title": "Mote Notes",
      "subtitle": "Mote",
      "description": "Open a floating notepad that automatically saves and syncs to Mote.",
      "mode": "no-view"
    }
  ],
  "preferences": [
    {
      "name": "transport",
      "type": "dropdown",
      "required": true,
      "title": "Connection",
      "default": "ssh",
      "description": "SSH uses your existing RN connection. HTTPS is available when your domain is ready.",
      "data": [
        {
          "title": "SSH (RN)",
          "value": "ssh"
        },
        {
          "title": "HTTPS",
          "value": "https"
        }
      ]
    },
    {
      "name": "sshTarget",
      "type": "textfield",
      "required": false,
      "title": "SSH Host",
      "description": "An existing host in ~/.ssh/config.",
      "default": "rn"
    },
    {
      "name": "serverUrl",
      "type": "textfield",
      "required": true,
      "title": "Server URL",
      "description": "Your Mote website address.",
      "default": "https://mote.caten.top",
      "placeholder": "https://mote.caten.top"
    },
    {
      "name": "captureToken",
      "type": "password",
      "required": true,
      "title": "Capture Token",
      "description": "Generate a capture token in Mote \u2192 Settings & Raycast."
    }
  ],
  "scripts": {
    "build": "bash ../native-notes/build.sh && ray build -e dist -o dist",
    "dev": "ray develop",
    "lint": "eslint src && prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "bash ../native-notes/test.sh",
    "lint:store": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "latest",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "typescript": "~6.0.2",
    "@raycast/eslint-config": "latest",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2"
  }
}
