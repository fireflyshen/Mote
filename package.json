{
    "name": "mote",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=24.12.0"
    },
    "scripts": {
        "dev": "node server/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "build": "tsc --noEmit && vite build && esbuild server/index.ts scripts/import-memos.ts scripts/capture.ts scripts/notepad.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=. --outdir=output",
        "start": "NODE_ENV=production node output/server/index.js",
        "test": "node --test tests/*.test.ts",
        "import:memos": "node scripts/import-memos.ts",
        "server:connect": "ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L 127.0.0.1:5174:127.0.0.1:4174 rn",
        "deploy": "bash scripts/deploy.sh",
        "setup:plugin": "npm --prefix floating-notes ci && npm --prefix raycast-extension ci",
        "build:plugin": "npm --prefix raycast-extension run build",
        "build:plugin:windows": "npm --prefix raycast-extension run build:windows",
        "test:plugin": "npm --prefix floating-notes run typecheck && npm --prefix floating-notes run lint && npm --prefix floating-notes test && npm --prefix raycast-extension run typecheck && npm --prefix raycast-extension run lint && npm --prefix raycast-extension test"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "esbuild": "0.28.1",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "jiti": "^2.7.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    }
}
